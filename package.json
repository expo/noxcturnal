{
  "name": "noxcturnal",
  "version": "0.1.0",
  "description": "Native-backed JavaScript transform runtime with visitor ergonomics",
  "license": "MIT",
  "files": [
    "dist",
    "*.node",
    "README.md",
    "FITMENT.md"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "audit:generate": "node scripts/generate-audits.mjs",
    "audit:check": "node scripts/generate-audits.mjs --check",
    "codegen": "node scripts/sync-oxc-event-schema.mjs && node scripts/generate-event-schema.mjs && node scripts/generate-inline-helpers.mjs && pnpm audit:generate",
    "codegen:check": "node scripts/sync-oxc-event-schema.mjs --check && node scripts/generate-event-schema.mjs --check && node scripts/generate-inline-helpers.mjs --check && pnpm audit:check",
    "architecture:check": "node scripts/check-architecture.mjs",
    "build:native": "napi build --platform --release",
    "hermes:fetch": "node scripts/fetch-hermes.mjs",
    "hermes:check": "node scripts/fetch-hermes.mjs --check",
    "codegen:estree": "node scripts/generate-estree-schema.mjs",
    "codegen:estree:check": "node scripts/generate-estree-schema.mjs --check",
    "flow:equivalence": "node scripts/flow-equivalence.mjs",
    "build:js": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "build": "pnpm build:native && pnpm build:js",
    "test": "vitest run",
    "benchmark": "vitest bench --run",
    "benchmark:cold-start": "node benchmark/cold-start-comparison.mjs",
    "benchmark:class-scaling": "node benchmark/class-scaling-comparison.mjs",
    "benchmark:super-linear": "node benchmark/super-linear-scaling.mjs",
    "benchmark:optimizer-comparison": "node benchmark/optimization-comparison.mjs",
    "package:check": "node scripts/check-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json && vitest --run --typecheck.only --typecheck.tsconfig tsconfig.type-tests.json",
    "format": "oxfmt .",
    "rust:format": "cargo fmt --check",
    "rust:lint": "cargo clippy --all-targets -- -D warnings",
    "verify": "pnpm build:js && pnpm architecture:check && pnpm codegen:check && pnpm typecheck && pnpm test && pnpm rust:format && pnpm rust:lint && cargo test && pnpm package:check",
    "verify:benchmark": "pnpm benchmark",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm build:js",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "dependencies": {
    "@oxc-project/types": "0.141.0"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@changesets/cli": "^2.31.1",
    "@changesets/get-github-info": "^0.6.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@napi-rs/cli": "^3.4.5",
    "@types/node": "^22.15.0",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.60.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "noxcturnal-darwin-arm64": "workspace:*",
    "noxcturnal-darwin-x64": "workspace:*",
    "noxcturnal-linux-arm64-gnu": "workspace:*",
    "noxcturnal-linux-arm64-musl": "workspace:*",
    "noxcturnal-linux-x64-gnu": "workspace:*",
    "noxcturnal-linux-x64-musl": "workspace:*",
    "noxcturnal-win32-arm64-msvc": "workspace:*",
    "noxcturnal-win32-x64-msvc": "workspace:*"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "napi": {
    "binaryName": "noxcturnal",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.1"
}
