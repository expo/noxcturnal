{
  "name": "noxcturnal",
  "version": "0.1.10",
  "description": "Native-backed JavaScript transform runtime with visitor ergonomics",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/noxcturnal.git"
  },
  "source": "./js/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/noxcturnal.js",
  "module": "./dist/noxcturnal.mjs",
  "types": "./dist/noxcturnal.d.ts",
  "exports": {
    ".": {
      "source": "./js/index.ts",
      "types": "./dist/noxcturnal.d.ts",
      "import": "./dist/noxcturnal.mjs",
      "require": "./dist/noxcturnal.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:js",
    "build:js": "rimraf dist && rollup -c scripts/rollup.config.mjs",
    "build:native": "node scripts/native.mjs build",
    "build:release": "node scripts/native.mjs build --release && pnpm build:js",
    "check": "pnpm codegen:check && pnpm format:check && pnpm check:types && pnpm lint && pnpm build:native && pnpm test && cargo test --workspace && pnpm package:check",
    "check:types": "tsc --noEmit && pnpm test:types",
    "codegen": "node scripts/sync-oxc-event-schema.mjs && node scripts/generate-event-schema.mjs && node scripts/generate-inline-helpers.mjs && node scripts/generate-regexp-unicode-properties.mjs && pnpm codegen:estree",
    "codegen:check": "node scripts/sync-oxc-event-schema.mjs --check && node scripts/generate-event-schema.mjs --check && node scripts/generate-inline-helpers.mjs --check && node scripts/generate-regexp-unicode-properties.mjs --check && pnpm codegen:estree:check",
    "codegen:estree": "node scripts/generate-estree-schema.mjs",
    "codegen:estree:check": "node scripts/generate-estree-schema.mjs --check",
    "test": "node scripts/native.mjs check && vitest run",
    "test:watch": "node scripts/native.mjs check && vitest",
    "test:coverage": "node scripts/native.mjs check && vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "benchmark": "node scripts/native.mjs check && vitest bench --run",
    "format": "oxfmt . && cargo fmt && cargo fmt --manifest-path vendor/oxc_transformer/Cargo.toml && cargo fmt --manifest-path vendor/oxc_react_compiler/Cargo.toml && cargo fmt --manifest-path vendor/oxc_semantic/Cargo.toml",
    "format:check": "oxfmt --check . && cargo fmt --check && cargo fmt --manifest-path vendor/oxc_transformer/Cargo.toml --check && cargo fmt --manifest-path vendor/oxc_react_compiler/Cargo.toml --check && cargo fmt --manifest-path vendor/oxc_semantic/Cargo.toml --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "package:check": "node scripts/check-package.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "pnpm build:js && node scripts/check-package.mjs --integrity",
    "prepublishOnly": "node scripts/release.mjs prepublish",
    "changeset": "changeset",
    "release": "node scripts/release.mjs publish"
  },
  "dependencies": {
    "@babel/code-frame": "^7.20.0",
    "@oxc-project/types": "0.154.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/generator": "7.29.7",
    "@babel/helpers": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-transform-async-generator-functions": "7.29.7",
    "@babel/plugin-transform-async-to-generator": "7.29.7",
    "@babel/plugin-transform-block-scoping": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/plugin-transform-class-static-block": "7.29.7",
    "@babel/plugin-transform-classes": "7.29.7",
    "@babel/plugin-transform-destructuring": "7.29.7",
    "@babel/plugin-transform-dotall-regex": "7.29.7",
    "@babel/plugin-transform-explicit-resource-management": "7.29.7",
    "@babel/plugin-transform-exponentiation-operator": "7.29.7",
    "@babel/plugin-transform-export-namespace-from": "7.29.7",
    "@babel/plugin-transform-flow-strip-types": "7.29.7",
    "@babel/plugin-transform-for-of": "7.29.7",
    "@babel/plugin-transform-logical-assignment-operators": "7.29.7",
    "@babel/plugin-transform-named-capturing-groups-regex": "7.29.7",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.29.7",
    "@babel/plugin-transform-object-rest-spread": "7.29.7",
    "@babel/plugin-transform-optional-catch-binding": "7.29.7",
    "@babel/plugin-transform-optional-chaining": "7.29.7",
    "@babel/plugin-transform-parameters": "7.29.7",
    "@babel/plugin-transform-private-methods": "7.29.7",
    "@babel/plugin-transform-private-property-in-object": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-react-jsx-development": "7.29.7",
    "@babel/plugin-transform-react-pure-annotations": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-sticky-regex": "7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/plugin-transform-unicode-property-regex": "7.29.7",
    "@babel/plugin-transform-unicode-regex": "7.29.7",
    "@babel/plugin-transform-unicode-sets-regex": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@changesets/cli": "^2.31.1",
    "@changesets/get-github-info": "^0.6.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@napi-rs/cli": "^3.4.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/babel__code-frame": "^7.0.6",
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-plugin-syntax-hermes-parser": "0.36.0",
    "babel-plugin-transform-flow-enums": "0.0.2",
    "babel-preset-expo": "56.0.13",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "hermes-parser": "0.36.0",
    "lint-staged": "^17.1.1",
    "npm": "11.6.2",
    "oxfmt": "^0.73.0",
    "prettier": "^3.9.6",
    "regenerate-unicode-properties": "10.2.2",
    "regexpu-core": "6.4.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "rollup-plugin-cjs-check": "^1.0.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@noxcturnal/noxcturnal-darwin-arm64": "workspace:*",
    "@noxcturnal/noxcturnal-darwin-x64": "workspace:*",
    "@noxcturnal/noxcturnal-linux-arm64-gnu": "workspace:*",
    "@noxcturnal/noxcturnal-linux-arm64-musl": "workspace:*",
    "@noxcturnal/noxcturnal-linux-x64-gnu": "workspace:*",
    "@noxcturnal/noxcturnal-linux-x64-musl": "workspace:*",
    "@noxcturnal/noxcturnal-win32-arm64-msvc": "workspace:*",
    "@noxcturnal/noxcturnal-win32-x64-msvc": "workspace:*"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "napi": {
    "binaryName": "noxcturnal",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
