{
  "name": "noxcturnal",
  "version": "0.1.0",
  "description": "Native-backed JavaScript transform runtime with visitor ergonomics",
  "license": "MIT",
  "source": "./js/index.ts",
  "files": [
    "dist",
    "*.node",
    "README.md",
    "FITMENT.md"
  ],
  "main": "./dist/noxcturnal.js",
  "module": "./dist/noxcturnal.mjs",
  "types": "./dist/noxcturnal.d.ts",
  "exports": {
    ".": {
      "source": "./js/index.ts",
      "types": "./dist/noxcturnal.d.ts",
      "import": "./dist/noxcturnal.mjs",
      "require": "./dist/noxcturnal.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:js",
    "build:js": "rimraf dist && rollup -c scripts/rollup.config.mjs",
    "build:native": "napi build --platform --release",
    "check": "pnpm codegen:check && pnpm check:types && pnpm format:check && pnpm lint && pnpm test && cargo test && pnpm package:check",
    "check:types": "tsc --noEmit && pnpm test:types",
    "codegen": "node scripts/sync-oxc-event-schema.mjs && node scripts/generate-event-schema.mjs && node scripts/generate-inline-helpers.mjs",
    "codegen:check": "node scripts/sync-oxc-event-schema.mjs --check && node scripts/generate-event-schema.mjs --check && node scripts/generate-inline-helpers.mjs --check",
    "codegen:estree": "node scripts/generate-estree-schema.mjs",
    "codegen:estree:check": "node scripts/generate-estree-schema.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "benchmark": "vitest bench --run",
    "format": "oxfmt . && cargo fmt",
    "format:check": "oxfmt --check . && cargo fmt --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "package:check": "node scripts/check-package.mjs",
    "package:release-check": "pnpm package:check --release",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "pnpm build:js && pnpm package:release-check",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "changeset publish"
  },
  "dependencies": {
    "@oxc-project/types": "0.141.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/runtime": "7.29.7",
    "@changesets/cli": "^2.31.1",
    "@changesets/get-github-info": "^0.6.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@napi-rs/cli": "^3.4.5",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.1",
    "lint-staged": "^17.1.1",
    "oxfmt": "^0.60.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.3",
    "rollup-plugin-cjs-check": "^1.0.3",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@noxcturnal/noxcturnal-darwin-arm64": "workspace:*",
    "@noxcturnal/noxcturnal-darwin-x64": "workspace:*",
    "@noxcturnal/noxcturnal-linux-arm64-gnu": "workspace:*",
    "@noxcturnal/noxcturnal-linux-arm64-musl": "workspace:*",
    "@noxcturnal/noxcturnal-linux-x64-gnu": "workspace:*",
    "@noxcturnal/noxcturnal-linux-x64-musl": "workspace:*",
    "@noxcturnal/noxcturnal-win32-arm64-msvc": "workspace:*",
    "@noxcturnal/noxcturnal-win32-x64-msvc": "workspace:*"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "napi": {
    "binaryName": "noxcturnal",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.12.1"
}
